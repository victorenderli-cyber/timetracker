# ===== Backend (variáveis de ambiente) =====
# SQLite (desenvolvimento local — default)
# DATABASE_URL=sqlite+aiosqlite:///./timetracker.db

# PostgreSQL (produção / Docker / Render)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timetracker

# Gere uma chave segura em produção, ex.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-in-production

# Tempo de vida do token JWT (minutos). 10080 = 7 dias.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis (opcional / reservado)
REDIS_URL=redis://localhost:6379/0

# Origens permitidas para CORS (lista JSON). Em produção use a URL do frontend.
# Ex.: ["https://timetracker-frontend.onrender.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# ===== Frontend (variáveis de build, configuradas no Dockerfile/render.yaml) =====
# VITE_API_URL=/api/v1        (default: mesma origem, nginx faz proxy)
# Em dev local aponte para o backend, ex.: VITE_API_URL=http://localhost:8000/api/v1